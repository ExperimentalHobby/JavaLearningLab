@startuml activity-diagram
skinparam defaultFontName VL Gothic

title アクティビティ図: 対話ループ全体の流れ

start
:操作方法を案内する;
while (次の入力行があるか?) is (ある)
  :1行分の入力を受け取る;
  if (空行か?) then (yes)
  elseif (終了コマンドか?) then (yes)
    break
  else (no)
    switch (コマンドの種類は?)
    case (list)
      :登録済みの図形すべてについて\n説明文字列を表示する;
      :合計面積を表示する;
    case (circle/rectangle/triangle)
      if (寸法が正しく数値として解釈でき、\n個数も一致するか?) then (yes)
        if (寸法は図形として成立するか?\n(負の半径でない・三角不等式を満たす等)) then (yes)
          :図形を生成し一覧に追加する;
        else (no)
          :エラー内容を表示する;
        endif
      else (no)
        :エラー内容を表示する;
      endif
    case (不明なコマンド)
      :エラー内容を表示する;
    endswitch
  endif
endwhile (ない)
:終了する;
stop

@enduml
