@startuml activity-diagram
skinparam defaultFontName VL Gothic

title アクティビティ図: 対話ループ全体の流れ

start
:操作方法を案内する;
while (次の入力行があるか?) is (ある)
  :1行分の入力を受け取る;
  if (空行か?) then (yes)
  elseif (終了コマンドか?) then (yes)
    break
  else (no)
    switch (コマンドの種類は?)
    case (list)
      :一覧・合計・平均・最高額を表示する;
    case (byCategory)
      :カテゴリ別合計を表示する;
    case (add)
      if (4項目に分解でき、金額・数量が\n正しく数値として解釈できるか?) then (yes)
        :売上レコードとして追加する;
      else (no)
        :エラー内容を表示する;
      endif
    case (不明なコマンド)
      :エラー内容を表示する;
    endswitch
  endif
endwhile (ない)
:終了する;
stop

@enduml
