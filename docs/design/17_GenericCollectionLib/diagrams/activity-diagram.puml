@startuml activity-diagram
skinparam defaultFontName VL Gothic

title アクティビティ図: 対話ループ全体の流れ

start
:操作方法を案内する;
while (次の入力行があるか?) is (ある)
  :1行分の入力を受け取る;
  if (空行か?) then (yes)
  elseif (終了コマンドか?) then (yes)
    break
  else (no)
    switch (対象の種類は?)
    case (stack)
      if (push/pop/peek/sizeのいずれかで、\n空コレクションへのpop/peekでないか?) then (yes)
        :スタックを操作し結果を表示する;
      else (no)
        :エラー内容を表示する;
      endif
    case (queue)
      if (enqueue/dequeue/peek/sizeのいずれかで、\n空コレクションへのdequeue/peekでないか?) then (yes)
        :キューを操作し結果を表示する;
      else (no)
        :エラー内容を表示する;
      endif
    case (不明なコマンド)
      :エラー内容を表示する;
    endswitch
  endif
endwhile (ない)
:終了する;
stop

@enduml
