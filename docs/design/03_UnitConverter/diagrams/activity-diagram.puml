@startuml activity-diagram
skinparam defaultFontName VL Gothic

title アクティビティ図: 対話ループ全体の流れ

start
:操作方法を案内する;
while (次の入力行があるか?) is (ある)
  :1行分の入力を受け取る;
  if (空行か?) then (yes)
  elseif (終了コマンドか?) then (yes)
    break
  else (no)
    if (数値・変換元単位・変換先単位の\n3要素に正しく分解・変換できるか?) then (yes)
      if (変換元単位・変換先単位は\n同じカテゴリに属するか?) then (yes)
        :単位を変換する;
        :変換結果を表示する;
      else (no)
        :エラー内容を表示する;
      endif
    else (no)
      :エラー内容を表示する;
    endif
  endif
endwhile (ない)
:終了する;
stop

@enduml
